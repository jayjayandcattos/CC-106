  <!-- Ask Question (with Category filter) -->
  <block id="6b0b48c23c7446f3adf6c6966d86f4e8" type="procedures_defnoreturn" x="-1000" y="-200">
    <field name="NAME">AskQuestion</field>
    <statement name="STACK">
      <block id="a06f78ffa637442b959e518034b5b569" type="local_declaration_statement">
        <mutation><localname name="q_pair"></localname></mutation>
        <field name="VAR0">q_pair</field>
        <value name="DECL0">
          <block id="4e3dc4ca603344419f4952d68533b5d8" type="controls_choose">
            <value name="TEST">
              <block id="3e007f14bbc840a19049a71a70078eae" type="logic_compare">
                <field name="OP">EQ</field>
                <value name="A"><block id="b09573b68c5b463b9b7a4b2f1a6dfd72" type="lexical_variable_get"><field name="VAR">global selected_category</field></block></value>
                <value name="B"><block id="e671cb9944ea4fb3ba523a9e6e403002" type="text"><field name="TEXT">GEO</field></block></value>
              </block>
            </value>
            <value name="THENRETURN">
              <block id="15116c09883540358efcabebd2dc62d0" type="lists_pick_random_item"><value name="LIST"><block id="ee4707a16c17447da42ced0a93e415e6" type="lexical_variable_get"><field name="VAR">global q_geo</field></block></value></block>
            </value>
            <value name="ELSERETURN">
              <block id="f33da5d35f4148e3b5146a26685c8956" type="controls_choose">
                <value name="TEST">
                  <block id="ca6ca07eabdb47a88ebe375dc2d57121" type="logic_compare">
                    <field name="OP">EQ</field>
                    <value name="A"><block id="e74ad093ee6643a2b67f2db0c2dfdba9" type="lexical_variable_get"><field name="VAR">global selected_category</field></block></value>
                    <value name="B"><block id="81d71ccff1334e09840e00d503c6be30" type="text"><field name="TEXT">MATH</field></block></value>
                  </block>
                </value>
                <value name="THENRETURN">
                  <block id="f5ea0b1d622a42e7b5bca34e6e004dee" type="lists_pick_random_item"><value name="LIST"><block id="55fb8e4f670c4f16b5e6de83a7120b44" type="lexical_variable_get"><field name="VAR">global q_math</field></block></value></block>
                </value>
                <value name="ELSERETURN">
                  <block id="56c6a4bd0e3241f6890176096f34b5dd" type="lists_pick_random_item"><value name="LIST"><block id="bbb5b207e1684478a0f7f0ff802ff3b1" type="lexical_variable_get"><field name="VAR">global q_trivia</field></block></value></block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="STACK">
          <block id="bcd7bae5756b4c9ca372f06b6789275e" type="lexical_variable_set">
            <field name="VAR">global current_answer</field>
            <value name="VALUE">
              <block id="7ae277b6b95d4de78726b728c7f6fc90" type="lists_select_item">
                <value name="LIST"><block id="54bc7047da754012be18c6924b35a51a" type="lexical_variable_get"><field name="VAR">q_pair</field></block></value>
                <value name="NUM"><block id="bf907a4819fb4390be1db454cef9b965" type="math_number"><field name="NUM">2</field></block></value>
              </block>
            </value>
            <next>
              <block id="66d6f1c69c7b4466b76e11e548e78abc" type="component_method">
                <mutation component_type="Notifier" method_name="ShowTextDialog" is_generic="false" instance_name="Notifier1"></mutation>
                <field name="COMPONENT_SELECTOR">Notifier1</field>
                <value name="ARG0">
                  <block id="d54bf79dce79492fab74e40b1823f346" type="lists_select_item">
                    <value name="LIST"><block id="267cac38e4f44f33a7ca2cecb0ba6e1e" type="lexical_variable_get"><field name="VAR">q_pair</field></block></value>
                    <value name="NUM"><block id="b9b42153c34a4112bf8262bfdd9e64e9" type="math_number"><field name="NUM">1</field></block></value>
                  </block>
                </value>
                <value name="ARG1"><block id="a3459ee0e2064965a760ff806b8fd802" type="text"><field name="TEXT">Knowledge Gate</field></block></value>
                <value name="ARG2"><block id="adf12a38e90f47b58e91ef57fbf89402" type="logic_boolean"><field name="BOOL">FALSE</field></block></value>
              </block>
            </next>
