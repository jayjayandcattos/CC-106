            <mutation component_type="Notifier" method_name="ShowMessageDialog" is_generic="false" instance_name="Notifier1"></mutation>
            <field name="COMPONENT_SELECTOR">Notifier1</field>
            <value name="ARG0"><block id="140d32d080154369bef776271a81ffc6" type="text"><field name="TEXT">Incorrect! Turn passed to the opponent.</field></block></value>
            <value name="ARG1"><block id="64f360d7e5454d629a3f173e999f3b24" type="text"><field name="TEXT">Oops!</field></block></value>
            <value name="ARG2"><block id="65f0408bf32b4a57b2f327f69d7840df" type="text"><field name="TEXT">OK</field></block></value>
          </block>
        </statement>
        <next>
          <!-- SWAP TURN & CHECK WIN -->
          <block id="b49dcfa5d3314c00acde272c60c97bbd" type="controls_if">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block id="41a2f855c39e4a109b605b9b1f1f2e99" type="logic_compare">
                <field name="OP">EQ</field>
                <value name="A"><block id="26c1e990bb724d2eb0d07762ff2f7c11" type="lexical_variable_get"><field name="VAR">global turn</field></block></value>
                <value name="B"><block id="1e8129dc60ad4982afa99871f08559f0" type="text"><field name="TEXT">X</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block id="65b34e1f85b1469684d65d1595b3424f" type="lexical_variable_set">
                <field name="VAR">global turn</field>
                <value name="VALUE"><block id="0e04b80677d74ceea630e6bf6e4a415d" type="text"><field name="TEXT">O</field></block></value>
              </block>
            </statement>
            <statement name="ELSE">
              <block id="37cb77d31d9342cf8de60d4945f8a319" type="lexical_variable_set">
                <field name="VAR">global turn</field>
                <value name="VALUE"><block id="6afe4973043443a7b31e5290284846fc" type="text"><field name="TEXT">X</field></block></value>
              </block>
            </statement>
            <next>
              <block id="614e3115cbb74a60b0135bd216ae572f" type="component_set_get">
                <mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="LblTurn"></mutation>
                <field name="COMPONENT_SELECTOR">LblTurn</field>
                <field name="PROP">Text</field>
                <value name="VALUE">
                   <block id="60701dfd77cb4618b00e555bb869b0e7" type="text_join">
                      <mutation items="2"></mutation>
                      <value name="ADD0"><block id="4aed2e37b50143fd84a30c89b87de1e2" type="lexical_variable_get"><field name="VAR">global turn</field></block></value>
                      <value name="ADD1"><block id="13d129a19140462ba8ae34c9f79550ed" type="text"><field name="TEXT"> Turn</field></block></value>
                   </block>
                </value>
                <next>
                  <block id="30d40066f0c34f1887b784c099471d14" type="procedures_callnoreturn">
                    <mutation name="CheckWin"></mutation>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block id="4a1310fa1d6b42d5897d8ba5cd903e98" type="component_event" x="-1000" y="1000">
    <mutation component_type="Button" is_generic="false" instance_name="BtnReset" event_name="Click"></mutation>
